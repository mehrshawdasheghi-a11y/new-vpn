{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "new-vpn",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "87418293-c105-461d-878d-f3b8737392e4","database_name": "new-vpn" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "dabcf101f53543aa9cbf67297b762ff7" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
